# ============================================
# Med Africa WhatsApp Complaint System
# Environment Variables
# ============================================

# --- OpenRouter API (Claude via OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# --- Google Sheets ---
GOOGLE_SHEETS_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# --- 360dialog WhatsApp API ---
DIALOG360_API_KEY=your_360dialog_api_key_here

# --- Manager Notifications ---
MANAGER_WHATSAPP_NUMBER=212600000000
MANAGER_EMAIL=manager@medafrica.ma

# --- n8n Configuration ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_strong_password
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com/webhook/whatsapp-webhook

# --- Database (n8n) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=changeme_db_password

# --- WordPress ---
WORDPRESS_URL=https://yourdomain.com
