{% comment %}
  Spring Discount Auto-Applied badge.
  Paste this entire snippet into a "Custom Liquid" block in the Shopify theme editor.
{%- endcomment -%}

<div class="spring-discount-badge">
  <span class="spring-discount-badge__dot" aria-hidden="true"></span>
  <span class="spring-discount-badge__text">Spring Discount Auto-Applied</span>
</div>

<style>
  .spring-discount-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1.5px solid #ec3a8a;
    border-radius: 9999px;
    background-color: #ffffff;
    font-family: inherit;
    line-height: 1;
    box-sizing: border-box;
  }

  .spring-discount-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #ec3a8a;
    flex-shrink: 0;
  }

  .spring-discount-badge__text {
    color: #ec3a8a;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .spring-discount-badge {
      padding: 5px 12px;
    }
    .spring-discount-badge__text {
      font-size: 11px;
    }
  }
</style>
